#!/usr/bin/env python3
"""Prints the Kover aggregate report (build/reports/kover/report.xml) as a Markdown table."""
import sys
import xml.etree.ElementTree as ET
from pathlib import Path

report = Path(__file__).resolve().parent.parent / "build/reports/kover/report.xml"
if not report.exists():
    print("No coverage report: run ./gradlew koverXmlReport first.")
    sys.exit(0)

root = ET.parse(report).getroot()
print("| Counter | Covered | Missed | Coverage |")
print("|---|---:|---:|---:|")
for counter in root.findall("counter"):
    covered, missed = int(counter.get("covered")), int(counter.get("missed"))
    total = covered + missed
    percent = 100 * covered / total if total else 100.0
    print(f"| {counter.get('type').lower()} | {covered} | {missed} | {percent:.1f}% |")
