#!/usr/bin/env bash
# Checks the Developer Certificate of Origin sign-off on every commit a pull request adds.
#
#   scripts/check-dco <base-sha> <head-sha>
#
# Every commit reachable from <head-sha> but not from <base-sha> must carry a Signed-off-by trailer of
# the form "Name <email>" whose email is the commit's author email, compared without regard to case
# (CONTRIBUTING.md, "Developer Certificate of Origin"). Only the email is compared, not the name.
# Trailers are parsed by git, so a "Signed-off-by:" line in the middle of the message does not count.
#
# A merge commit is skipped only when it adds nothing to its parents: re-merging them with git gives
# exactly its tree (git show --remerge-diff prints nothing; git 2.36 or newer). A merge that resolves a
# conflict, adds or drops content, or has more than two parents is checked like any other commit.
#
# History from before the DCO was adopted is exempt: .github/dco-baseline names one commit (its first
# line that is neither blank nor a comment, a full SHA), and that commit and its ancestors are not
# checked. The file is read from <base-sha> only: a baseline that only <head-sha> has, or that it
# changes, is ignored, so a branch cannot exempt its own commits, and a base without the file exempts
# nothing. In CI the DCO workflow runs on pull_request_target: the workflow, this script and the
# baseline all come from the base branch, which has the baseline whenever it has the workflow, so a
# pull request can change none of them. A baseline that is not a commit of this repository is ignored
# with a warning.
#
# Exit status: 0 when every commit passes or there is none to check, 1 when a commit fails, 2 for
# invalid arguments. Needs nothing but bash and git.
set -euo pipefail

contributing=https://github.com/adihack/kcoap/blob/main/CONTRIBUTING.md#developer-certificate-of-origin
baseline_path=.github/dco-baseline

# A sign-off value: a name without < or >, then one address in angle brackets, and nothing after it.
signoff_re='^([^<>]*[^<>[:space:]])[[:space:]]+<[[:space:]]*([^<>[:space:]]+@[^<>[:space:]]+)[[:space:]]*>$'

if [ "$#" -ne 2 ]; then
  echo "usage: scripts/check-dco <base-sha> <head-sha>" >&2
  exit 2
fi
base=$1
head=$2

for rev in "$base" "$head"; do
  if ! git rev-parse --verify --quiet "${rev}^{commit}" >/dev/null; then
    echo "check-dco: not a commit in this repository: $rev" >&2
    exit 2
  fi
done

lowercase() {
  printf '%s' "$1" | tr '[:upper:]' '[:lower:]'
}

# The first line of standard input that is neither blank nor a comment, without surrounding whitespace.
first_entry() {
  local line
  while IFS= read -r line || [ -n "$line" ]; do
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"
    if [ -z "$line" ] || [ "${line:0:1}" = "#" ]; then
      continue
    fi
    printf '%s\n' "$line"
    return 0
  done
  return 0
}

# True when <commit> is a merge of two parents whose tree is exactly what git's re-merge gives. Any
# error, such as a git without --remerge-diff, counts as false, so the merge is then checked.
is_clean_merge() {
  local commit=$1 parents remerge
  parents=$(git log -1 --format=%P "$commit")
  set -- $parents
  [ "$#" -eq 2 ] || return 1
  remerge=$(git show --remerge-diff --no-ext-diff --no-color --format= "$commit" 2>/dev/null) || return 1
  [ -z "$remerge" ]
}

# The baseline, from the base commit's tree only.
baseline=
if git cat-file -e "${base}:${baseline_path}" 2>/dev/null; then
  content=$(git show "${base}:${baseline_path}")
  entry=$(first_entry <<<"$content")
  short_source=$(git rev-parse --short "$base")
  if [ -z "$entry" ]; then
    echo "warning: $baseline_path in $short_source names no commit; no history is exempt" >&2
  elif ! [[ "$entry" =~ ^[0-9a-fA-F]{40}([0-9a-fA-F]{24})?$ ]]; then
    echo "warning: $baseline_path in $short_source is not a full commit SHA, ignored: $entry" >&2
  elif ! git rev-parse --verify --quiet "${entry}^{commit}" >/dev/null; then
    echo "warning: $baseline_path in $short_source is not a commit in this repository, ignored: $entry" >&2
  else
    baseline=$(lowercase "$entry")
    echo "Exempt from the DCO: $(git rev-parse --short "$baseline") and its ancestors ($baseline_path in $short_source)"
  fi
fi

range=("$head" "^$base")
if [ -n "$baseline" ]; then
  range+=("^$baseline")
fi
commits=$(git rev-list --reverse "${range[@]}")

if [ -z "$commits" ]; then
  echo "No commits to check."
  exit 0
fi

checked=0
skipped=0
failed=0
while IFS= read -r commit; do
  short=$(git rev-parse --short "$commit")
  subject=$(git log -1 --format=%s "$commit")

  if is_clean_merge "$commit"; then
    printf '%s  SKIP  %s (a merge that adds nothing to its parents)\n' "$short" "$subject"
    skipped=$((skipped + 1))
    continue
  fi

  checked=$((checked + 1))
  author=$(git log -1 --format=%ae "$commit")
  signoffs=$(git log -1 --format='%(trailers:key=Signed-off-by,valueonly,unfold)' "$commit")

  values=()
  match=false
  while IFS= read -r value; do
    [ -n "$value" ] || continue
    values+=("$value")
    if [[ "$value" =~ $signoff_re ]] && [[ "$author" == *@* ]] &&
      [ "$(lowercase "${BASH_REMATCH[2]}")" = "$(lowercase "$author")" ]; then
      match=true
    fi
  done <<<"$signoffs"

  if [ "$match" = true ]; then
    printf '%s  OK    %s\n' "$short" "$subject"
  elif [[ "$author" != *@* ]]; then
    printf '%s  FAIL  %s (the author email "%s" is not an address)\n' "$short" "$subject" "$author"
    failed=$((failed + 1))
  elif [ "${#values[@]}" -eq 0 ]; then
    printf '%s  FAIL  %s (no Signed-off-by trailer)\n' "$short" "$subject"
    failed=$((failed + 1))
  else
    found=$(printf '%s; ' "${values[@]}")
    printf '%s  FAIL  %s (no "Signed-off-by: Name <%s>"; found: %s)\n' \
      "$short" "$subject" "$author" "${found%; }"
    failed=$((failed + 1))
  fi
done <<<"$commits"

skipped_note=
if [ "$skipped" -eq 1 ]; then
  skipped_note=", 1 clean merge skipped"
elif [ "$skipped" -gt 1 ]; then
  skipped_note=", $skipped clean merges skipped"
fi

if [ "$failed" -eq 0 ]; then
  echo "Every commit is signed off by its author ($checked checked$skipped_note)."
  exit 0
fi

full_base=$(git rev-parse "$base")
cat <<EOF

Commits without a sign-off by their author: $failed of $checked$skipped_note.

Every commit needs a "Signed-off-by: Name <email>" trailer whose email is the commit's author email,
which certifies the Developer Certificate of Origin (the DCO file). To sign off every commit of the
branch and update the pull request:

    git rebase --signoff $full_base
    git push --force-with-lease

($full_base is the base of the pull request; fetch it from github.com/adihack/kcoap first if your
clone does not have it.)

git adds the sign-off with your configured user.name and user.email, so they must match the author of
each commit. A merge that resolves a conflict or adds content needs a sign-off too; rebasing instead of
merging avoids such merges. Details: $contributing
EOF
exit 1
