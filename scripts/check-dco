#!/usr/bin/env bash
# Checks the Developer Certificate of Origin sign-off on every commit a pull request adds.
#
#   scripts/check-dco <base-sha> <head-sha>
#
# Every non-merge commit reachable from <head-sha> but not from <base-sha> must carry a Signed-off-by
# trailer whose email is the commit's author email, compared without regard to case (CONTRIBUTING.md,
# "Developer Certificate of Origin"). Trailers are parsed by git, so a "Signed-off-by:" line in the
# middle of the message does not count.
#
# History from before the DCO was adopted is exempt: .github/dco-baseline names one commit (its first
# line that is neither blank nor a comment, a full SHA), and that commit and its ancestors are not
# checked. The file is read from <base-sha>, so a pull request cannot exempt its own commits by editing
# it. Only when <base-sha> has no such file, as for the pull request that adds it, is it read from
# <head-sha>. A baseline that is not a commit of this repository is ignored with a warning.
#
# Exit status: 0 when every commit passes or there is none to check, 1 when a commit fails, 2 for
# invalid arguments. Needs nothing but bash and git.
set -euo pipefail

contributing=https://github.com/adihack/kcoap/blob/main/CONTRIBUTING.md#developer-certificate-of-origin
baseline_path=.github/dco-baseline

if [ "$#" -ne 2 ]; then
  echo "usage: scripts/check-dco <base-sha> <head-sha>" >&2
  exit 2
fi
base=$1
head=$2

for rev in "$base" "$head"; do
  if ! git rev-parse --verify --quiet "${rev}^{commit}" >/dev/null; then
    echo "check-dco: not a commit in this repository: $rev" >&2
    exit 2
  fi
done

lowercase() {
  printf '%s' "$1" | tr '[:upper:]' '[:lower:]'
}

# The first line of standard input that is neither blank nor a comment, without surrounding whitespace.
first_entry() {
  local line
  while IFS= read -r line || [ -n "$line" ]; do
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"
    if [ -z "$line" ] || [ "${line:0:1}" = "#" ]; then
      continue
    fi
    printf '%s\n' "$line"
    return 0
  done
  return 0
}

# The baseline: from the base commit's tree, or from the head commit's when the base has no such file.
baseline=
baseline_source=
if git cat-file -e "${base}:${baseline_path}" 2>/dev/null; then
  baseline_source=$base
elif git cat-file -e "${head}:${baseline_path}" 2>/dev/null; then
  baseline_source=$head
fi
if [ -n "$baseline_source" ]; then
  content=$(git show "${baseline_source}:${baseline_path}")
  entry=$(first_entry <<<"$content")
  short_source=$(git rev-parse --short "$baseline_source")
  if [ -z "$entry" ]; then
    echo "warning: $baseline_path in $short_source names no commit; no history is exempt" >&2
  elif ! [[ "$entry" =~ ^[0-9a-fA-F]{40}([0-9a-fA-F]{24})?$ ]]; then
    echo "warning: $baseline_path in $short_source is not a full commit SHA, ignored: $entry" >&2
  elif ! git rev-parse --verify --quiet "${entry}^{commit}" >/dev/null; then
    echo "warning: $baseline_path in $short_source is not a commit in this repository, ignored: $entry" >&2
  else
    baseline=$(lowercase "$entry")
    echo "Exempt from the DCO: $(git rev-parse --short "$baseline") and its ancestors ($baseline_path in $short_source)"
  fi
fi

range=("$head" "^$base")
if [ -n "$baseline" ]; then
  range+=("^$baseline")
fi
commits=$(git rev-list --no-merges --reverse "${range[@]}")

if [ -z "$commits" ]; then
  echo "No commits to check."
  exit 0
fi

checked=0
failed=0
while IFS= read -r commit; do
  checked=$((checked + 1))
  short=$(git rev-parse --short "$commit")
  subject=$(git log -1 --format=%s "$commit")
  author=$(git log -1 --format=%ae "$commit")
  signoffs=$(git log -1 --format='%(trailers:key=Signed-off-by,valueonly,unfold)' "$commit")

  emails=()
  match=false
  while IFS= read -r value; do
    [ -n "$value" ] || continue
    email=${value##*<}
    email=${email%%>*}
    emails+=("$email")
    if [ "$(lowercase "$email")" = "$(lowercase "$author")" ]; then
      match=true
    fi
  done <<<"$signoffs"

  if [ "$match" = true ]; then
    printf '%s  OK    %s\n' "$short" "$subject"
  elif [ "${#emails[@]}" -eq 0 ]; then
    printf '%s  FAIL  %s (no Signed-off-by trailer)\n' "$short" "$subject"
    failed=$((failed + 1))
  else
    found=$(printf '%s, ' "${emails[@]}")
    printf '%s  FAIL  %s (no Signed-off-by with the author email %s; signed off by %s)\n' \
      "$short" "$subject" "$author" "${found%, }"
    failed=$((failed + 1))
  fi
done <<<"$commits"

if [ "$failed" -eq 0 ]; then
  echo "Every commit is signed off by its author ($checked checked)."
  exit 0
fi

full_base=$(git rev-parse "$base")
cat <<EOF

Commits without a sign-off by their author: $failed of $checked.

Every commit needs a "Signed-off-by: Name <email>" trailer whose email is the commit's author email,
which certifies the Developer Certificate of Origin (the DCO file). To sign off every commit of the
branch and update the pull request:

    git rebase --signoff $full_base
    git push --force-with-lease

($full_base is the base of the pull request; fetch it from github.com/adihack/kcoap first if your
clone does not have it.)

git adds the sign-off with your configured user.name and user.email, so they must match the author of
each commit. Details: $contributing
EOF
exit 1
